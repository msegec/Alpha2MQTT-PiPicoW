#!/usr/bin/env bash
# Build and run the firmware host tests with the system g++.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
for test in "$here"/test_*.cpp; do
	name=$(basename "$test" .cpp)
	g++ -std=c++17 -Wall -Wextra -Werror -I"$here/../../Alpha2MQTT" "$test" -o "$out/$name"
	echo "$name"
	"$out/$name"
done
